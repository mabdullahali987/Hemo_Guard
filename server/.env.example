# Backend secrets go in Vercel (not Flutter / not GitHub).
NODE_ENV=production
# Copy Supabase Dashboard -> Connect -> Transaction pooler (port 6543).
# Percent-encode special characters in its password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# TLS verification is enabled by default. DATABASE_SSL=disable is only for local PG tests.
# ADMIN_EMAIL and ADMIN_PASSWORD are only for the one-time LOCAL bootstrap script.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=12-plus-character-strong-password
