<%- include('header') %>
<section class="page-heading page-heading-hero"><div><p class="eyebrow">AUDIT &amp; ACCOUNTABILITY</p><h1>System <span>activity log.</span></h1><p>Review sign-ins, account changes and report events. Patient images and blood-test measurements are not stored in this audit system.</p></div><a class="button primary" href="/admin/reports">Explore report totals →</a></section>
<section class="panel table-panel glass"><div class="panel-heading"><div><p class="eyebrow">USAGE SNAPSHOT</p><h2>Reports by account</h2><p>Top individual and laboratory accounts by completed analyses.</p></div><a class="button secondary small" href="/admin/reports">All accounts →</a></div><div class="table-scroll"><table><thead><tr><th>User or laboratory</th><th>Type</th><th>Reports</th><th>Scanned</th><th>Manual</th><th>History</th></tr></thead><tbody><% for (const a of accounts.slice(0,10)) { %><tr><td><div class="person-cell"><span class="avatar <%= a.account_type==='lab' ? 'avatar-lab' : '' %>"><%= a.account_type==='lab' ? '▦' : '◉' %></span><span><strong><%= a.display_name %></strong><small><%= a.email %></small><% if (a.is_deleted) { %><small class="state-note">Archived</small><% } %></span></div></td><td><span class="type-pill"><%= a.account_type==='lab' ? 'Laboratory' : 'Individual' %></span></td><td><strong class="table-number"><%= a.reports_count %></strong></td><td><%= a.scans_count %></td><td><%= a.manual_count %></td><td><a class="history-button" href="/admin/reports/<%= encodeURIComponent(a.id) %>"><span>View history</span><span class="history-arrow" aria-hidden="true">→</span></a></td></tr><% } %><% if (!accounts.length) { %><tr class="empty-row"><td colspan="6"><div class="empty-state"><span>✧</span><strong>No report activity yet</strong><p>Report totals will appear as accounts complete analyses.</p></div></td></tr><% } %></tbody></table></div><% if (accounts.length>10) { %><p class="table-footnote">Showing 10 of <%= accounts.length %> accounts. <a href="/admin/reports">See everyone →</a></p><% } %></section>
<section class="panel table-panel glass"><div class="panel-heading"><div><p class="eyebrow">ACCOUNTABILITY</p><h2>Audit timeline</h2><p>Recent account operations, authentication events and report completions.</p></div><span class="count-chip"><%= events.length %> events on this page</span></div><div class="table-tools"><label for="audit-search" class="search-field"><span aria-hidden="true">⌕</span><input id="audit-search" type="search" data-table-search="audit-table" placeholder="Search event, actor or account…" autocomplete="off"><span class="key-tip">SEARCH</span></label></div><div class="table-scroll"><table id="audit-table"><thead><tr><th>Date (UTC)</th><th>Event</th><th>Actor</th><th>Account</th><th>Details</th></tr></thead><tbody><% for (const e of events) { %><tr><td class="date-cell"><%= e.created_at %></td><td><span class="event-tag"><%= e.action %></span></td><td><%= e.actor_email || 'System' %></td><td><strong><%= e.subject_name || '—' %></strong><small><%= e.subject_email || '' %></small></td><td><code><%= JSON.stringify(e.details) %></code></td></tr><% } %><% if (!events.length) { %><tr class="empty-row"><td colspan="5"><div class="empty-state"><span>⌁</span><strong>No events to display</strong><p>Updates will appear as the system is used.</p></div></td></tr><% } %></tbody></table></div><div class="search-empty" data-empty-for="audit-table" hidden>No audit events match your search on this page.</div><div class="form-actions pagination"><% if (offset>0) { %><a class="button secondary small" href="/admin/audit?offset=<%= Math.max(0,offset-200) %>">← Newer events</a><% } %><% if (events.length===200) { %><a class="button secondary small" href="/admin/audit?offset=<%= offset+200 %>">Older events →</a><% } %></div></section>
<%- include('footer') %>
