<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#f8f5fb">
  <script>try{const d=sessionStorage.getItem('hg-nav-direction');if(d)document.documentElement.dataset.navEnter=d;}catch(_){}</script>
  <title>HemoGuard · Superadmin</title>
  <link rel="stylesheet" href="/static/admin.css?v=navmotion20261021">
  <script src="/static/admin.js?v=navmotion20261021" defer></script>
</head>
<body class="admin-page">
  <div class="liquid-bg" aria-hidden="true">
    <span class="liquid-orb liquid-orb-a"></span>
    <span class="liquid-orb liquid-orb-b"></span>
    <span class="liquid-orb liquid-orb-c"></span>
  </div>
  <div class="layout">
    <header class="topbar glass">
      <a class="brand" href="/admin" aria-label="HemoGuard admin home">
        
        <img class="brand-logo" src="/static/hemoguard-logo.png" alt="">
        <span class="brand-title"><strong>HemoGuard</strong><small>SUPERADMIN</small></span>
      </a>
      <nav class="main-nav" aria-label="Main navigation" data-main-nav>
        <span class="nav-focus-indicator" data-nav-focus aria-hidden="true"></span>
        <a href="/admin" data-nav-index="0" <% if (page==='dashboard' || page==='accounts') { %>aria-current="page"<% } %>><span class="nav-dot" aria-hidden="true"></span>Accounts</a>
        <a href="/admin/reports" data-nav-index="1" <% if (page==='reports') { %>aria-current="page"<% } %>><span class="nav-dot" aria-hidden="true"></span>Reports</a>
        <a href="/admin/audit" data-nav-index="2" <% if (page==='audit') { %>aria-current="page"<% } %>><span class="nav-dot" aria-hidden="true"></span>Audit</a>
      </nav>
      <div class="top-actions">
        <a class="admin-profile-link" href="/admin/profile" title="Open your profile" <% if (page==='profile') { %>aria-current="page"<% } %>>
          <span class="admin-profile-avatar" aria-hidden="true">
            <% if (adminProfileImage) { %><img src="<%= adminProfileImage %>" alt=""><% } else { %><span><%= String(adminName || adminEmail || 'A').trim().charAt(0).toUpperCase() %></span><% } %>
            <i class="online-dot"></i>
          </span>
          <span class="admin-profile-copy"><strong><%= adminName || 'Superadmin' %></strong><small><%= adminEmail %></small></span>
          <span class="profile-chevron" aria-hidden="true">›</span>
        </a>
        <form method="post" action="/admin/logout" data-logout-form>
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <button type="submit" class="logout-button" title="Sign out securely"><span>Sign out</span><span aria-hidden="true">↗</span></button>
        </form>
      </div>
    </header>
    <main class="shell" id="main-content">
      <% if (notice) { %>
        <div class="notice <%= noticeType === 'error' ? 'error' : 'success' %>" role="<%= noticeType === 'error' ? 'alert' : 'status' %>"><span class="notice-icon" aria-hidden="true"><%= noticeType === 'error' ? '!' : '✓' %></span><span><%= notice %></span></div>
      <% } %>
